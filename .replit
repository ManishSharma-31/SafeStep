entrypoint = "main.go"
run = ["go", "run", "."]
modules = ["go-1.21"]

[env]
GOPATH="$REPL_HOME/gopath"

[nix]
channel = "stable-25_05"
packages = ["gcc"]

[gitHubImport]
requiredFiles = [".replit"]

[deployment]
build = "CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o main"
run = "./main"
ignorePorts = false
deploymentTarget = "gce"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Durable Engine"

[[workflows.workflow]]
name = "Durable Engine"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "go run main.go"
